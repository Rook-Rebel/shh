# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase → Project Settings → API → service_role secret.
# SERVER-ONLY — used only inside Server Actions (video create/update/delete)
# after the admin session is verified. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_, never expose to the client, never commit
# a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (simple env-var auth — not Supabase Auth).
# There is only ever one admin. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: a dedicated secret for signing the admin session cookie.
# If omitted, ADMIN_PASSWORD is used to sign it instead — set this for
# slightly better hygiene (so rotating the password doesn't also need to
# invalidate the signing key).
ADMIN_SESSION_SECRET=
